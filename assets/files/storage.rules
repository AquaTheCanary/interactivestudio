rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cloudbase files are private to their owner by default.
    match /users/{uid}/cloudbase/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null || request.resource.size <= 100 * 1024 * 1024);
    }

    // Private user assets used by Project and its products.
    match /users/{uid}/assets/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null || request.resource.size <= 20 * 1024 * 1024);
    }

    // Deny everything not explicitly covered above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
