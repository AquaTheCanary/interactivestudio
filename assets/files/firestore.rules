rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(code) {
      return exists(/databases/$(database)/documents/rooms/$(code));
    }
    function owner(code) {
      return signedIn() && roomExists(code)
        && get(/databases/$(database)/documents/rooms/$(code)).data.ownerUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'live'
        && code.size() == 6
        && code.matches('^[0-9]+$')
        && request.resource.data.slides is list
        && request.resource.data.slides.size() > 0
        && request.resource.data.slides.size() <= 150;
      allow get: if signedIn() || (resource.data.status == 'live' && code.size() == 6 && code.matches('^[0-9]+$'));
      allow list: if signedIn();
      allow update: if owner(code)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slides is list
        && request.resource.data.slides.size() > 0
        && request.resource.data.slides.size() <= 150
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'slides', 'activeSlide', 'status', 'updatedAt']);
      allow delete: if owner(code);

      match /participants/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || owner(code));
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']);
        allow delete: if owner(code);
      }

      match /votes/{voteId} {
        allow read: if owner(code);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.choice is string
          && request.resource.data.choice.size() > 0
          && request.resource.data.choice.size() <= 120
          && request.resource.data.slideIndex is int
          && exists(/databases/$(database)/documents/rooms/$(code)/participants/$(request.auth.uid));
        allow update: if false;
        allow delete: if owner(code);
      }

      match /private/{docId} {
        allow read: if owner(code) && docId == 'notes';
        allow create, update: if owner(code) && docId == 'notes'
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if owner(code) && docId == 'notes';
      }
    }

    match /websites/{slug} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.siteName is string
        && request.resource.data.headline is string;
      allow get: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'published';
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }


    match /websiteHosts/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug is string
        && request.resource.data.status in ['draft', 'published'];
      allow get: if resource == null
        || resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.hostname == hostname
        && request.resource.data.websiteSlug == resource.data.websiteSlug
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /websiteDomains/{hostname} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hostname == hostname
        && request.resource.data.status == 'pending';
      allow get: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'active';
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.hostname == resource.data.hostname
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkedAt', 'updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /userProfiles/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && handle.matches('^[a-z0-9][a-z0-9-]{1,22}[a-z0-9]
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

  }
}
);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

  }
}
